{
  "name": "ryphos-obsidian",
  "version": "0.1.2",
  "description": "Plugin de Obsidian para sincronizar Memorias de Ryphos.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "ignore": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "obsidian": "1.14.4",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "8.72.0"
  },
  "license": "MIT"
}
